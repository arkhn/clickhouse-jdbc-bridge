      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "targets": [
        { "expr": "sum by (action) (rate(jvm_gc_pause_seconds_sum{job=\"jdbc-bridge\"}[1m]))", "legendFormat": "{{action}}" }
      ]
